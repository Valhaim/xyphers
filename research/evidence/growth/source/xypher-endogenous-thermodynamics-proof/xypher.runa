-- Prospective typed policy surface for CAL-ENDO-1.
--
-- This file declares frozen local inputs, exact adaptive transformations,
-- physical records, observer separation, and protocol types. It does not run
-- the apparatus, evaluate a logarithm, or assert an experimental result. The
-- independent Rust verifier owns authoritative enumeration and every gate.
--
-- Frozen boundary commit: 7ee278ed14ade12689540481903e4832f53442d7
-- Frozen boundary sha256: a3aafdc4d29dc3b6c8a2c5bf8deb554745a311b2f3485e1577f3697b1aa14c80

-- EXACT VALUES AND FINITE PHYSICAL MEDIA

# ExactRatio(numerator: Int, denominator: Int)
# EpisodeId(index: Int)
# PortSymbol(index: Int)
# PrefixWord(encoded: String, level: Int)
# Descriptor(id: Int)
# WorkCell(id: Int, energy: Int, charged: Bool, locked: Bool)
# OperationRecord(id: Int, state: OperationRecordState)
# OperationRecordState = OperationBlank | OperationWritten
# SemanticState = Blank | Pending | Success | Failure
# CandidateKind = Fresh | Alias
# BucketKey(symbol: PortSymbol, kind: CandidateKind)
# SemanticRecord(id: Int, bucket: BucketKey, state: SemanticState)
# BucketCounts(successes: Int, terminal_trials: Int)
# MemoryProjection(memory: MemoryLog, bucket: BucketKey)
# MemoryLog(records: List(SemanticRecord))
# OperationBank(records: List(OperationRecord), inverse_cursor: Int)
# TypedWorkStore(build: List(WorkCell), repair: List(WorkCell), observation: List(WorkCell))

> ratio(numerator: Int, denominator: Int) -> ExactRatio {
    ExactRatio(numerator, denominator)
}

> exact_ratio_is_zero(value: ExactRatio) -> Bool {
    value.numerator == 0
}

> exact_ratio_sum_equals(left: ExactRatio, right: ExactRatio, total: ExactRatio) -> Bool {
    (left.numerator * right.denominator + right.numerator * left.denominator) * total.denominator == total.numerator * left.denominator * right.denominator
}

> exact_ratios_are_opposites(left: ExactRatio, right: ExactRatio) -> Bool {
    left.numerator * right.denominator == 0 - right.numerator * left.denominator
}

> same_candidate_kind(left: CandidateKind, right: CandidateKind) -> Bool {
    match left {
        | Fresh -> match right { | Fresh -> true | Alias -> false }
        | Alias -> match right { | Fresh -> false | Alias -> true }
    }
}

> same_bucket(left: BucketKey, right: BucketKey) -> Bool {
    left.symbol.index == right.symbol.index && same_candidate_kind(left.kind, right.kind)
}

-- Sufficient statistics are derived from terminal physical records. They are
-- never a separately writable counter in the authoritative state.
> terminal_bucket_counts(records: List(SemanticRecord), bucket: BucketKey) -> BucketCounts {
    if length(records) == 0 { BucketCounts(0, 0) }
    else {
        = record = head(records)
        = rest = terminal_bucket_counts(tail(records), bucket)
        if same_bucket(record.bucket, bucket) {
            match record.state {
                | Blank -> rest
                | Pending -> rest
                | Success -> BucketCounts(rest.successes + 1, rest.terminal_trials + 1)
                | Failure -> BucketCounts(rest.successes, rest.terminal_trials + 1)
            }
        } else { rest }
    }
}

> predictive_mean(projection: MemoryProjection) -> ExactRatio {
    = counts = terminal_bucket_counts(projection.memory.records, projection.bucket)
    ExactRatio(counts.successes + 1, counts.terminal_trials + 2)
}

-- For R=p/q this is ((p+q)^2 * (3q-p)) / (8q^3). The Rust exact
-- implementation reduces the ratio before any comparison or report.
> integrated_phi(ruby: ExactRatio) -> ExactRatio {
    = p = ruby.numerator
    = q = ruby.denominator
    ExactRatio((p + q) * (p + q) * (3 * q - p), 8 * q * q * q)
}

> competing_probability(left: ExactRatio, right: ExactRatio) -> ExactRatio {
    = left_scaled = left.numerator * right.denominator
    = right_scaled = right.numerator * left.denominator
    ExactRatio(left_scaled, left_scaled + right_scaled)
}

# ReservoirVertex(word: PrefixWord, descriptor: Descriptor, energy_index: Int, executable: Bool)
# StructuralIncidence(parent: PrefixWord, child: PrefixWord, live_clock: ExactRatio)
# OpenPort(parent: PrefixWord, symbol: PortSymbol)
# WorkspaceBinding(parent: PrefixWord, symbol: PortSymbol, child: PrefixWord, descriptor: Descriptor, certified: Bool)
# QuarantinedBinding(parent: PrefixWord, symbol: PortSymbol, descriptor: Descriptor)
# ConfigurationSpace(promoted: List(ReservoirVertex), workspace: List(WorkspaceBinding), quarantined: List(QuarantinedBinding), open_ports: List(OpenPort))
# CandidateIdentity(episode: EpisodeId, port: OpenPort, kind: CandidateKind)
-- Attempt history is finite physical state. BUILD slots are identity-bound at
-- initialization; the two REPAIR slots start blank and are rebound by PERTURB.
# AttemptLane = BuildAttemptBit | RepairAttemptBit
# OptionalCandidateIdentity = NoCandidateIdentity | SomeCandidateIdentity(value: CandidateIdentity)
# AttemptBit(id: Int, lane: AttemptLane, identity: OptionalCandidateIdentity, attempted: Bool)
# AttemptBitStore(bits: List(AttemptBit))
# OccupiedReservoirState(word: PrefixWord)
# ProbeCoordinate(mesostate: Int, microstate: Int, energy_index: Int)
# FreeInventory(descriptors: List(Descriptor))
# OperationPhase = Build | Credit | Promote | Operate | Repair | Contact
# CursorState = NoCursor | LiveCursor(port: OpenPort)
# RepairTargetState = NoRepairTarget | LiveRepairTarget(port: OpenPort)
# SchedulerCapacities(payload_capacity: Int)
# ExternalPerturbationCell = NoExternalPerturbationCell | DeclaredExternalPerturbationCell(cell: WorkCell)
# SchedulerQueue(episode: EpisodeId, cursor: CursorState, repair_target: RepairTargetState, attempt_bits: AttemptBitStore, capacities: SchedulerCapacities, payloads: List(ObservationPayload), external_perturbation_cell: ExternalPerturbationCell)
# ObservationPayload(bucket: BucketKey, outcome: SemanticState, consumed: Bool)
# CompleteState(configuration: ConfigurationSpace, occupied: OccupiedReservoirState, alphabet: List(PortSymbol), energy_quantum: Int, probe: ProbeCoordinate, inventory: FreeInventory, work: TypedWorkStore, memory: MemoryLog, operations: OperationBank, phase: OperationPhase, queue: SchedulerQueue)

-- Prefix incidence certifies state-space structure; it never moves the live
-- occupied coordinate. Only separately declared reciprocal channels do that.
> structural_incidence(parent: PrefixWord, child: PrefixWord) -> StructuralIncidence {
    StructuralIncidence(parent, child, ExactRatio(0, 1))
}

-- BEGIN CONSTRUCTION_POLICY

-- Everything between the construction-policy markers is the complete input
-- and transformation surface of the adaptive builder. A source-contract test
-- keeps observer quantities out of this region.

-- This restricted projection is the only state consumed by candidate
-- construction. It deliberately contains no occupied probe coordinate,
-- observer classification, forbidden sentinel, or fitted quantity.
# BuilderQueueView(episode: EpisodeId, cursor: CursorState, repair_target: RepairTargetState, attempt_bits: AttemptBitStore, capacities: SchedulerCapacities, payloads: List(ObservationPayload), external_perturbation_cell: ExternalPerturbationCell)
# BuilderView(configuration: ConfigurationSpace, alphabet: List(PortSymbol), inventory: FreeInventory, work: TypedWorkStore, memory: MemoryLog, operations: OperationBank, phase: OperationPhase, queue: BuilderQueueView)

> builder_queue_view(queue: SchedulerQueue) -> BuilderQueueView {
    BuilderQueueView(queue.episode, queue.cursor, queue.repair_target, queue.attempt_bits, queue.capacities, queue.payloads, queue.external_perturbation_cell)
}

> builder_view(state: CompleteState) -> BuilderView {
    BuilderView(state.configuration, state.alphabet, state.inventory, state.work, state.memory, state.operations, state.phase, builder_queue_view(state.queue))
}

-- CRYSTAL: one enabled local opportunity plus record-derived directed flow.

# CrystalReadback(diamond: ExactRatio, ruby: ExactRatio, opal: ExactRatio)
# CandidateProposal(identity: CandidateIdentity, descriptor: Descriptor, crystal: CrystalReadback, hazard: ExactRatio)
# CandidateSlot = UntriedCandidate(proposal: CandidateProposal) | TriedCandidate(identity: CandidateIdentity) | MissingAttemptBit(identity: CandidateIdentity)
# CandidateSet = NoCandidates | LiveCandidates(fresh: CandidateSlot, alias: CandidateSlot)

> crystal_readback(projection: MemoryProjection) -> CrystalReadback {
    = diamond = ExactRatio(1, 1)
    = ruby = predictive_mean(projection)
    = opal = integrated_phi(ruby)
    CrystalReadback(diamond, ruby, opal)
}

> memory_projection(view: BuilderView, bucket: BucketKey) -> MemoryProjection {
    MemoryProjection(view.memory, bucket)
}

> local_proposal(view: BuilderView, port: OpenPort, kind: CandidateKind, descriptor: Descriptor) -> CandidateProposal {
    = projection = memory_projection(view, BucketKey(port.symbol, kind))
    = crystal = crystal_readback(projection)
    CandidateProposal(CandidateIdentity(view.queue.episode, port, kind), descriptor, crystal, crystal.opal)
}

> same_prefix_word(left: PrefixWord, right: PrefixWord) -> Bool {
    left.encoded == right.encoded && left.level == right.level
}

> same_candidate_identity(left: CandidateIdentity, right: CandidateIdentity) -> Bool {
    left.episode.index == right.episode.index && same_prefix_word(left.port.parent, right.port.parent) && left.port.symbol.index == right.port.symbol.index && same_candidate_kind(left.kind, right.kind)
}

> same_attempt_lane(left: AttemptLane, right: AttemptLane) -> Bool {
    match left {
        | BuildAttemptBit -> match right { | BuildAttemptBit -> true | RepairAttemptBit -> false }
        | RepairAttemptBit -> match right { | BuildAttemptBit -> false | RepairAttemptBit -> true }
    }
}

> matching_attempt_bit(bits: List(AttemptBit), identity: CandidateIdentity, lane: AttemptLane, attempted: Bool) -> Bool {
    if length(bits) == 0 { false }
    else {
        = bit = head(bits)
        match bit.identity {
            | NoCandidateIdentity -> matching_attempt_bit(tail(bits), identity, lane, attempted)
            | SomeCandidateIdentity(value: assigned) -> {
                if same_attempt_lane(bit.lane, lane) && same_candidate_identity(assigned, identity) && bit.attempted == attempted { true }
                else { matching_attempt_bit(tail(bits), identity, lane, attempted) }
            }
        }
    }
}

> candidate_slot(view: BuilderView, proposal: CandidateProposal) -> CandidateSlot {
    match view.phase {
        | Build -> {
            if matching_attempt_bit(view.queue.attempt_bits.bits, proposal.identity, BuildAttemptBit, false) { UntriedCandidate(proposal) }
            else if matching_attempt_bit(view.queue.attempt_bits.bits, proposal.identity, BuildAttemptBit, true) { TriedCandidate(proposal.identity) }
            else { MissingAttemptBit(proposal.identity) }
        }
        | Repair -> {
            if matching_attempt_bit(view.queue.attempt_bits.bits, proposal.identity, RepairAttemptBit, false) { UntriedCandidate(proposal) }
            else if matching_attempt_bit(view.queue.attempt_bits.bits, proposal.identity, RepairAttemptBit, true) { TriedCandidate(proposal.identity) }
            else { MissingAttemptBit(proposal.identity) }
        }
        | Credit -> MissingAttemptBit(proposal.identity)
        | Promote -> MissingAttemptBit(proposal.identity)
        | Operate -> MissingAttemptBit(proposal.identity)
        | Contact -> MissingAttemptBit(proposal.identity)
    }
}

> one_port_candidates(view: BuilderView, parent_descriptor: Descriptor) -> CandidateSet {
    if length(view.inventory.descriptors) == 0 { NoCandidates }
    else {
        match view.queue.cursor {
            | NoCursor -> NoCandidates
            | LiveCursor(port: port) -> {
                = free_descriptor = head(view.inventory.descriptors)
                = fresh = local_proposal(view, port, Fresh, free_descriptor)
                = alias = local_proposal(view, port, Alias, parent_descriptor)
                LiveCandidates(candidate_slot(view, fresh), candidate_slot(view, alias))
            }
        }
    }
}

-- THERMO WORK ENABLEMENT: no candidate acts without a charged unlocked cell.

# CandidateEnablement = Enabled(proposal: CandidateProposal, cell: WorkCell) | DisabledNoWork(proposal: CandidateProposal) | DisabledNoAttemptBit(proposal: CandidateProposal)

> enable_from_cells(proposal: CandidateProposal, cells: List(WorkCell), attempt_bits: AttemptBitStore, lane: AttemptLane) -> CandidateEnablement {
    if matching_attempt_bit(attempt_bits.bits, proposal.identity, lane, false) {
        if length(cells) == 0 { DisabledNoWork(proposal) }
        else {
            = cell = head(cells)
            if cell.charged && cell.locked == false { Enabled(proposal, cell) }
            else { DisabledNoWork(proposal) }
        }
    } else {
        DisabledNoAttemptBit(proposal)
    }
}

> enable_with_work(view: BuilderView, proposal: CandidateProposal) -> CandidateEnablement {
    match view.phase {
        | Build -> enable_from_cells(proposal, view.work.build, view.queue.attempt_bits, BuildAttemptBit)
        | Credit -> DisabledNoWork(proposal)
        | Promote -> DisabledNoWork(proposal)
        | Operate -> DisabledNoWork(proposal)
        | Repair -> enable_from_cells(proposal, view.work.repair, view.queue.attempt_bits, RepairAttemptBit)
        | Contact -> DisabledNoWork(proposal)
    }
}

-- PRAXION ACTION MAPS AND THEIR FINITE RECORD EFFECTS.

-- Every driven edge carries both declared energy boundaries. The internal
-- augmented boundary contains B_W. PERTURB additionally reports the complete
-- boundary containing its separately named external protocol cell.
# WorkingBoundary(delta_energy: Int, heat_into_working: Int, work_on_working: Int)
# AugmentedBoundary(delta_energy: Int, external_heat: Int, external_work: Int)
# CompleteBoundary(delta_energy_with_named_source: Int)
# WorkLedger(working: WorkingBoundary, internal_augmented: AugmentedBoundary, complete: CompleteBoundary)
# ResourceDelta(descriptors: Int, internal_charged_cells: Int, external_charged_cells: Int, blank_operations: Int, blank_semantic_records: Int, attempted_candidates: Int)
# ForwardChannel = FreshBind | AliasQuarantine | CreditPending | PromoteFrontier | PerturbLeaf | AbsorbObservation
# InverseChannel = Unfresh | Unfail | Uncredit | Demote | Unperturb | Unabsorb
# DrivenOperation(channel: ForwardChannel, inverse: InverseChannel, before: BuilderView, after: BuilderView, ledger: WorkLedger, resources: ResourceDelta)
# EnabledEvent(channel: ForwardChannel, hazard: ExactRatio)
# EnabledEventSet(events: List(EnabledEvent))
# ActionReceipt(event: ForwardChannel, hazard: ExactRatio, operation_record: OperationRecord, ledger: WorkLedger)
# EventTransition(enabled: EnabledEvent, hazard: ExactRatio, channel: ForwardChannel, successor: BuilderView, forward_receipt: ActionReceipt, ledger: WorkLedger, inverse: ActionReceipt, inverse_restores_source: Bool)
# ProtocolStep(index: Int, selected: EnabledEvent, receipt: ActionReceipt)
# ProtocolTrace(forward_steps: List(ProtocolStep), reverse_lifo_receipts: List(ActionReceipt), full_reverse_lifo_restores_initial: Bool)

> inverse_channel(channel: ForwardChannel) -> InverseChannel {
    match channel {
        | FreshBind -> Unfresh
        | AliasQuarantine -> Unfail
        | CreditPending -> Uncredit
        | PromoteFrontier -> Demote
        | PerturbLeaf -> Unperturb
        | AbsorbObservation -> Unabsorb
    }
}

> one_cell_work_ledger(cell: WorkCell) -> WorkLedger {
    = working = WorkingBoundary(cell.energy, 0, cell.energy)
    = augmented = AugmentedBoundary(0, 0, 0)
    WorkLedger(working, augmented, CompleteBoundary(0))
}

> perturb_work_ledger(external_cell: WorkCell) -> WorkLedger {
    = working = WorkingBoundary(external_cell.energy, 0, external_cell.energy)
    = internal_augmented = AugmentedBoundary(external_cell.energy, 0, external_cell.energy)
    WorkLedger(working, internal_augmented, CompleteBoundary(0))
}

> fresh_operation(before: BuilderView, after: BuilderView, cell: WorkCell) -> DrivenOperation {
    = ledger = one_cell_work_ledger(cell)
    = resources = ResourceDelta(-1, -1, 0, -1, -1, 1)
    DrivenOperation(FreshBind, Unfresh, before, after, ledger, resources)
}

> alias_operation(before: BuilderView, after: BuilderView, cell: WorkCell) -> DrivenOperation {
    = ledger = one_cell_work_ledger(cell)
    = resources = ResourceDelta(0, -1, 0, -1, -1, 1)
    DrivenOperation(AliasQuarantine, Unfail, before, after, ledger, resources)
}

> credit_operation(before: BuilderView, after: BuilderView, cell: WorkCell) -> DrivenOperation {
    = ledger = one_cell_work_ledger(cell)
    = resources = ResourceDelta(0, -1, 0, -1, 0, 0)
    DrivenOperation(CreditPending, Uncredit, before, after, ledger, resources)
}

> promote_operation(before: BuilderView, after: BuilderView, cell: WorkCell) -> DrivenOperation {
    = ledger = one_cell_work_ledger(cell)
    = resources = ResourceDelta(0, -1, 0, -1, 0, 0)
    DrivenOperation(PromoteFrontier, Demote, before, after, ledger, resources)
}

> perturb_operation(before: BuilderView, after: BuilderView, external_cell: WorkCell) -> DrivenOperation {
    = external_ledger = perturb_work_ledger(external_cell)
    = resources = ResourceDelta(1, 0, -1, -1, 0, 0)
    DrivenOperation(PerturbLeaf, Unperturb, before, after, external_ledger, resources)
}

> absorb_operation(before: BuilderView, after: BuilderView, cell: WorkCell) -> DrivenOperation {
    = ledger = one_cell_work_ledger(cell)
    = resources = ResourceDelta(0, -1, 0, -1, -1, 0)
    DrivenOperation(AbsorbObservation, Unabsorb, before, after, ledger, resources)
}

-- Enablement exposes only the event identity and hazard. The authoritative
-- transition keeps successor, ledger, forward receipt, and exact inverse in
-- one replayable envelope.
> enabled_event(operation: DrivenOperation, hazard: ExactRatio) -> EnabledEvent {
    EnabledEvent(operation.channel, hazard)
}

> enabled_events(events: List(EnabledEvent)) -> EnabledEventSet { EnabledEventSet(events) }

> event_successor(transition: EventTransition) -> BuilderView { transition.successor }
> event_ledger(transition: EventTransition) -> WorkLedger { transition.ledger }
> event_inverse(transition: EventTransition) -> ActionReceipt { transition.inverse }

-- Backward credit writes PENDING -> SUCCESS only after the whole local
-- frontier is certified. Alias quarantine writes FAILURE and leaves the port
-- open. Passive absorption writes through the same semantic record medium.

# LocalOutcome(identity: CandidateIdentity, before: SemanticState, after: SemanticState)

> fresh_pending(identity: CandidateIdentity) -> LocalOutcome {
    LocalOutcome(identity, Blank, Pending)
}

> alias_failure(identity: CandidateIdentity) -> LocalOutcome {
    LocalOutcome(identity, Blank, Failure)
}

> promoted_success(identity: CandidateIdentity) -> LocalOutcome {
    LocalOutcome(identity, Pending, Success)
}

> absorbed_terminal(identity: CandidateIdentity, observed: SemanticState) -> LocalOutcome {
    LocalOutcome(identity, Blank, observed)
}

-- FINITE CREATION AND REPAIR CERTIFICATES.

# FrontierRank(open_ports: Int, alias_untried: Int, value: Int)
# PhaseRank(frontiers_remaining: Int, phase_order: Int, local_value: Int)
# ResourceCertificate(descriptors: Int, candidate_records: Int, operation_records: Int, build_cells: Int, repair_cells: Int)
# AttemptBitAssignment(identity: CandidateIdentity, bit_id: Int)
-- The verifier enumerates every admissible depth-three leaf before certifying
-- that the same two initially blank REPAIR slots can bind its candidate pair.
# AttemptBitCapacityCertificate(base: Int, off_shell_inventory: Bool, descriptor_capacity: Int, construction_candidate_identities: Int, repair_attempt_slots: Int, declared_attempt_bits: Int, semantic_record_capacity: Int, candidate_identities: List(CandidateIdentity), assigned_attempt_bits: List(AttemptBitAssignment), every_candidate_identity_has_distinct_bit: Bool, repair_slots_are_predeclared_blank_resources: Bool, every_admissible_leaf_can_bind_the_same_repair_slots: Bool, capacity_cannot_truncate_construction: Bool)

> frontier_rank(open_ports: Int, alias_untried: Int) -> FrontierRank {
    FrontierRank(open_ports, alias_untried, 2 * open_ports + alias_untried)
}

> build_rank(frontiers_remaining: Int, local: FrontierRank) -> PhaseRank {
    PhaseRank(frontiers_remaining, 2, local.value)
}

> credit_rank(frontiers_remaining: Int, pending: Int) -> PhaseRank {
    PhaseRank(frontiers_remaining, 1, pending)
}

> promote_rank(frontiers_remaining: Int) -> PhaseRank {
    PhaseRank(frontiers_remaining, 0, 1)
}

> resource_certificate(port_count: Int) -> ResourceCertificate {
    = candidate_records = 2 * port_count
    = operation_records = 3 * port_count + 3
    ResourceCertificate(port_count, candidate_records, operation_records, operation_records, 4)
}

> attempt_bit_capacity_certificate(base: Int, off_shell_inventory: Bool, descriptor_capacity: Int, candidate_identities: List(CandidateIdentity), assigned_attempt_bits: List(AttemptBitAssignment), declared_attempt_bits: Int, semantic_record_capacity: Int, every_candidate_identity_has_distinct_bit: Bool, repair_slots_are_predeclared_blank_resources: Bool, every_admissible_leaf_can_bind_the_same_repair_slots: Bool, capacity_cannot_truncate_construction: Bool) -> AttemptBitCapacityCertificate {
    AttemptBitCapacityCertificate(base, off_shell_inventory, descriptor_capacity, length(candidate_identities), 2, declared_attempt_bits, semantic_record_capacity, candidate_identities, assigned_attempt_bits, every_candidate_identity_has_distinct_bit, repair_slots_are_predeclared_blank_resources, every_admissible_leaf_can_bind_the_same_repair_slots, capacity_cannot_truncate_construction)
}

-- END CONSTRUCTION_POLICY

-- BEGIN BUILDER_ADMISSION

-- C06 and C07 are concrete requests, not merely forbidden names. The only
-- route that can produce BuilderView rejects both before construction policy.
# TargetCountRequest(shell_counts: List(Int), target_multiplicity_ratios: List(ExactRatio), global_deficit: List(Int))
# HeldOutRatePair(forward: ExactRatio, reverse: ExactRatio)
# HeldOutTrafficRequest(labelled_rate_pairs: List(HeldOutRatePair), agreement_reward: ExactRatio)
# BuilderRequest = LocalBuilderRequest(state: CompleteState) | TargetCountBuilderRequest(state: CompleteState, request: TargetCountRequest) | HeldOutTrafficBuilderRequest(state: CompleteState, request: HeldOutTrafficRequest)
# BuilderAdmissionError = TargetCountInput | HeldOutTrafficInput
# BuilderAdmission = AdmittedBuilder(view: BuilderView) | RejectedBuilder(error: BuilderAdmissionError)

> admit_builder_request(request: BuilderRequest) -> BuilderAdmission {
    match request {
        | LocalBuilderRequest(state: state) -> AdmittedBuilder(builder_view(state))
        | TargetCountBuilderRequest(state: _, request: _) -> RejectedBuilder(TargetCountInput)
        | HeldOutTrafficBuilderRequest(state: _, request: _) -> RejectedBuilder(HeldOutTrafficInput)
    }
}

-- END BUILDER_ADMISSION

