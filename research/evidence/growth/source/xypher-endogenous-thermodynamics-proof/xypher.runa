        GibbsInstalled,
        TargetCountBuilder,
        TrafficTrainedBuilder,
        PoisonInput,
        OffShellInventory,
        DescriptorPermutation,
        EnergyShuffle,
        LeafDeletion,
        RepairDisabled,
        DescriptorWithheld,
        PortLawMutation,
        MemoryClamp,
        MemoryPermutation,
        HiddenMemory,
        IdealCounters,
        LedgerLeak,
        ActivityOnly,
        ReverseMismatch
    ])
}
