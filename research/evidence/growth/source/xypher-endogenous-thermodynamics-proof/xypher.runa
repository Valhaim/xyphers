-- BEGIN SCM_MEMORY_INTERVENTION

-- do(M) is surgical replacement of one semantic-memory coordinate. It is
-- intentionally off the autonomous history manifold: the prior ABSORB record
-- is preserved, while the ordinary event kernel remains defined afterward.
# StateManifold = ReachableAutonomousState | OffManifoldScmState
# HistoricalAbsorbRecordPolicy = PreserveHistoricalAbsorbRecord
# ScmMemoryIntervention(observed: CompleteState, intervened: CompleteState, semantic_record: Int, observed_bucket: BucketKey, intervened_bucket: BucketKey, manifold: StateManifold, history_policy: HistoricalAbsorbRecordPolicy)
# PostInterventionKernel(intervention: ScmMemoryIntervention, enabled: EnabledEventSet, transitions_replay: Bool)

> scm_memory_intervention(observed: CompleteState, intervened: CompleteState, semantic_record: Int, observed_bucket: BucketKey, intervened_bucket: BucketKey) -> ScmMemoryIntervention {
    ScmMemoryIntervention(observed, intervened, semantic_record, observed_bucket, intervened_bucket, OffManifoldScmState, PreserveHistoricalAbsorbRecord)
}

> post_intervention_kernel(intervention: ScmMemoryIntervention, enabled: EnabledEventSet, transitions_replay: Bool) -> PostInterventionKernel {
    PostInterventionKernel(intervention, enabled, transitions_replay)
}

-- END SCM_MEMORY_INTERVENTION

# MaintenanceDefect(parent_level: Int, leaf_level: Int, occupied_at_root: Bool, descriptor_returned: Bool, internal_repair_cells: Int, external_protocol_cells: Int)

> frozen_leaf_defect() -> MaintenanceDefect {
    MaintenanceDefect(2, 3, true, true, 4, 1)
}

# LegacyGateNoGo(phi_lower_open: ExactRatio, phi_upper_open: ExactRatio, history_gate_relation: String, zero_history: String)

> legacy_gate_no_go() -> LegacyGateNoGo {
    LegacyGateNoGo(ExactRatio(3, 8), ExactRatio(1, 1), "a_P > 1 after nonempty history", "UNDEFINED_WITHOUT_BOOTSTRAP")
}

-- BEGIN POST_CONSTRUCTION_OBSERVER

-- This surface receives a frozen completed architecture. No function in the
-- construction-policy section receives any value declared below.

# ShellObservation(energy_index: Int, actual_words: List(PrefixWord), multiplicity: Int)
# LogRatio(numerator: Int, denominator: Int)
# StateSlope(energy_quantum: Int, multiplicity_ratio: LogRatio)
# StateTemperature = UndefinedState | NonpositiveState | StateDependent(slopes: List(StateSlope)) | UniqueConstant(energy_quantum: Int, multiplicity_base: Int)
# StateCountReport(shells: List(ShellObservation), classification: StateTemperature)

# BodyMesostate(index: Int, energy_index: Int, intrinsic_microstates: Int)
# ProbeBody(zero: BodyMesostate, one: BodyMesostate, two: BodyMesostate, total_energy_index: Int)
# ThermalMicrostate(body_state: Int, body_microstate: Int, reservoir_word: PrefixWord)
# ThermalEdge(left: ThermalMicrostate, right: ThermalMicrostate, clock: ExactRatio)
# ProbeExchangeCoordinate(body: ProbeCoordinate, reservoir: PrefixWord)
# OptionalProbeEdge = NoDeletedProbeEdge | DeletedProbeEdge(source: ProbeExchangeCoordinate, target: ProbeExchangeCoordinate)
# SealedProbeProtocol(body_degeneracies: List(Int), body_energy_indices: List(Int), total_energy_index: Int, microscopic_clock: ExactRatio, deleted_directed_edge: OptionalProbeEdge)
# ProbeAuthoritativeState(xypher: CompleteState, protocol: SealedProbeProtocol)
# ContactCoordinate(left_reservoir: PrefixWord, right_reservoir: PrefixWord)
# ContactProtocol(quantum: ExactRatio, total_energy: ExactRatio, microscopic_clock: ExactRatio, prepared_macro_distribution: List(ExactRatio))
# ContactAuthoritativeState(left: CompleteState, right: CompleteState, protocol: ContactProtocol)
# AuthoritativeState = DrivenAuthoritativeState(state: CompleteState) | ProbeAuthoritativeStateValue(state: ProbeAuthoritativeState) | ContactAuthoritativeStateValue(state: ContactAuthoritativeState)
# AuthoritativeEvent = DrivenAuthoritativeEvent(event: EnabledEvent) | ProbeAuthoritativeEvent(target: ProbeExchangeCoordinate, hazard: ExactRatio) | ContactAuthoritativeEvent(target: ContactCoordinate, hazard: ExactRatio)
# ProbeHeatLedger(delta_body: ExactRatio, delta_reservoir: ExactRatio, heat_into_body: ExactRatio, work_on_body: ExactRatio, total_energy_delta: ExactRatio)
# ContactHeatLedger(delta_left: ExactRatio, delta_right: ExactRatio, heat_into_left: ExactRatio, heat_into_right: ExactRatio, work_on_left: ExactRatio, work_on_right: ExactRatio, total_energy_delta: ExactRatio)
# AuthoritativeLedger = DrivenAuthoritativeLedger(ledger: WorkLedger) | ProbeAuthoritativeLedger(ledger: ProbeHeatLedger) | ContactAuthoritativeLedger(ledger: ContactHeatLedger)
# AuthoritativeInverse = DrivenAuthoritativeInverse(receipt: ActionReceipt) | ReciprocalAuthoritativeInverse(event: AuthoritativeEvent)
# AuthoritativeTransition(source: AuthoritativeState, event: AuthoritativeEvent, successor: AuthoritativeState, ledger: AuthoritativeLedger, inverse: AuthoritativeInverse, inverse_restores_source: Bool)
# ProbeAuthoritativeEventRow(source: ProbeExchangeCoordinate, target: ProbeExchangeCoordinate, hazard: ExactRatio, reverse_hazard: ExactRatio, diagonal_from_source: ExactRatio, ledger: ProbeHeatLedger, source_and_successor_well_formed: Bool, noncoordinate_state_is_exactly_unchanged: Bool, inverse_restores_source: Bool)
# ProbeAuthoritativeKernelAudit(reference_xypher_state: CompleteState, protocol: SealedProbeProtocol, complete_coordinates: List(ProbeExchangeCoordinate), event_rows: List(ProbeAuthoritativeEventRow), every_state_reconstructs_from_reference: Bool, every_enabled_event_replays_from_one_authoritative_kernel: Bool, every_diagonal_is_negative_outgoing_sum: Bool, every_event_has_exact_reciprocal_and_heat_ledger: Bool)
# ContactAuthoritativeEventRow(source: ContactCoordinate, target: ContactCoordinate, hazard: ExactRatio, reverse_hazard: ExactRatio, diagonal_from_source: ExactRatio, ledger: ContactHeatLedger, source_and_successor_well_formed: Bool, noncoordinate_state_is_exactly_unchanged: Bool, inverse_restores_source: Bool)
# ContactAuthoritativeKernelAudit(reference_left_state: CompleteState, reference_right_state: CompleteState, shared_energy_gauge: ExactRatio, protocol: ContactProtocol, complete_coordinates: List(ContactCoordinate), event_rows: List(ContactAuthoritativeEventRow), both_full_xypher_states_are_authoritative: Bool, every_state_reconstructs_from_references: Bool, every_enabled_event_replays_from_one_authoritative_kernel: Bool, every_diagonal_is_negative_outgoing_sum: Bool, every_event_has_exact_reciprocal_and_heat_ledger: Bool)
# LabelledTraffic(label: String, forward_hazard: ExactRatio, reverse_hazard: ExactRatio, energy_gap: Int, intrinsic_ratio: ExactRatio)
# TrafficTemperature = NoTrafficValue | UniqueTrafficValue(energy_quantum: Int, multiplicity_base: Int) | IncompatibleTraffic
# ThermalReport(channels: List(LabelledTraffic), classification: TrafficTemperature, reverse_support: Bool, row_closed: Bool, strongly_lumpable: Bool, irreducible: Bool)
# InformationScope = CausalOnePort | ConstructionQuotient(base: Int, episode: EpisodeId, port: OpenPort)
# OutcomeRecordBranch(outcome: SemanticState, stored_record: SemanticState, probability: ExactRatio)
# OutcomeCopyInformation(scope: InformationScope, outcome_probabilities: List(ExactRatio), record_probabilities: List(ExactRatio), joint_probabilities: List(ExactRatio), branches: List(OutcomeRecordBranch), record_is_exact_copy: Bool, symbolic_entropy: String, symbolic_mutual_information: String)
# CausalRecordVariable = ImmutableFirstOperationRecordEntry
# ImmediateSemanticEvidence(fresh: SemanticState, alias: SemanticState, role: String)
# CausalMYDefinition(record_variable: CausalRecordVariable, immediate_semantic_evidence: ImmediateSemanticEvidence)
# InformationReport(scope: InformationScope, record_variable: String, branch_evidence: String, outcome_probabilities: List(ExactRatio), record_probabilities: List(ExactRatio), joint_distribution: List(ExactRatio), outcome_entropy: String, record_outcome_mutual_information: String, record_is_exact_copy: Bool)

> frozen_probe() -> ProbeBody {
    = zero = BodyMesostate(0, 0, 1)
    = one = BodyMesostate(1, 1, 2)
    = two = BodyMesostate(2, 2, 1)
    ProbeBody(zero, one, two, 3)
}

-- Probe and contact protocol values are sealed only after construction. They
-- are embedded in the authoritative state and never enter BuilderView.
> sealed_probe_protocol(microscopic_clock: ExactRatio) -> SealedProbeProtocol {
    SealedProbeProtocol([1, 2, 1], [0, 1, 2], 3, microscopic_clock, NoDeletedProbeEdge)
}

> frozen_contact_protocol(microscopic_clock: ExactRatio) -> ContactProtocol {
    ContactProtocol(ExactRatio(2, 1), ExactRatio(4, 1), microscopic_clock, [ExactRatio(1, 2), ExactRatio(1, 2)])
}

> probe_heat_ledger_closes(ledger: ProbeHeatLedger) -> Bool {
    exact_ratio_sum_equals(ledger.heat_into_body, ledger.work_on_body, ledger.delta_body) && exact_ratios_are_opposites(ledger.delta_reservoir, ledger.heat_into_body) && exact_ratio_sum_equals(ledger.delta_body, ledger.delta_reservoir, ledger.total_energy_delta) && exact_ratio_is_zero(ledger.total_energy_delta) && exact_ratio_is_zero(ledger.work_on_body)
}

> contact_heat_ledger_closes(ledger: ContactHeatLedger) -> Bool {
    exact_ratio_sum_equals(ledger.heat_into_left, ledger.work_on_left, ledger.delta_left) && exact_ratio_sum_equals(ledger.heat_into_right, ledger.work_on_right, ledger.delta_right) && exact_ratios_are_opposites(ledger.heat_into_left, ledger.heat_into_right) && exact_ratio_sum_equals(ledger.delta_left, ledger.delta_right, ledger.total_energy_delta) && exact_ratio_is_zero(ledger.total_energy_delta) && exact_ratio_is_zero(ledger.work_on_left) && exact_ratio_is_zero(ledger.work_on_right)
}

> same_semantic_state(left: SemanticState, right: SemanticState) -> Bool {
    match left {
        | Blank -> match right { | Blank -> true | Pending -> false | Success -> false | Failure -> false }
        | Pending -> match right { | Blank -> false | Pending -> true | Success -> false | Failure -> false }
        | Success -> match right { | Blank -> false | Pending -> false | Success -> true | Failure -> false }
        | Failure -> match right { | Blank -> false | Pending -> false | Success -> false | Failure -> true }
    }
}

> branch_record_is_copy(branch: OutcomeRecordBranch) -> Bool {
    same_semantic_state(branch.outcome, branch.stored_record)
}

> every_branch_record_is_copy(branches: List(OutcomeRecordBranch)) -> Bool {
    if length(branches) == 0 { true }
    else { branch_record_is_copy(head(branches)) && every_branch_record_is_copy(tail(branches)) }
}

-- Marginals and the joint law are inputs derived from exact authoritative
-- successor branches. This constructor derives the copy predicate; it does
-- not insert a successful information result prospectively.
> outcome_copy_information(scope: InformationScope, outcome_probabilities: List(ExactRatio), record_probabilities: List(ExactRatio), joint_probabilities: List(ExactRatio), branches: List(OutcomeRecordBranch), symbolic_entropy: String, symbolic_mutual_information: String) -> OutcomeCopyInformation {
    OutcomeCopyInformation(scope, outcome_probabilities, record_probabilities, joint_probabilities, branches, every_branch_record_is_copy(branches), symbolic_entropy, symbolic_mutual_information)
}

-- For the causal fixture M_Y is the immutable first action OperationRecord
-- entry. PENDING and FAILURE are immediate branch checks only; neither is the
-- causal random variable and neither is silently replaced by terminal state.
> causal_m_y_definition() -> CausalMYDefinition {
    CausalMYDefinition(ImmutableFirstOperationRecordEntry, ImmediateSemanticEvidence(Pending, Failure, "IMMEDIATE_EVIDENCE_ONLY_NOT_M_Y"))
}

> information_report(record_variable: String, branch_evidence: String, information: OutcomeCopyInformation) -> InformationReport {
    InformationReport(information.scope, record_variable, branch_evidence, information.outcome_probabilities, information.record_probabilities, information.joint_probabilities, information.symbolic_entropy, information.symbolic_mutual_information, information.record_is_exact_copy)
}

-- The observer represents logarithms symbolically through integer ratios.
> adjacent_state_slope(left: ShellObservation, right: ShellObservation, energy_quantum: Int) -> StateSlope {
    StateSlope(energy_quantum, LogRatio(right.multiplicity, left.multiplicity))
}

-- FINITE CONTACT IN ONE DECLARED ENERGY GAUGE.

# ReservoirIdentity(alphabet_size: Int, energy_quantum: Int)
# ContactFixture(name: String, first: ReservoirIdentity, second: ReservoirIdentity, transfer_quantum: Int, total_energy: Int)
# ContactFiber(name: String, multiplicity: Int)
# ContactGenerator(a_to_b: Int, b_to_a: Int, a_diagonal: Int, b_diagonal: Int)
# ContactPrediction(event_current_numerator: Int, event_current_denominator: Int, energy_current_numerator: Int, energy_current_denominator: Int)

> equal_contact_fixture() -> ContactFixture {
    ContactFixture("equal", ReservoirIdentity(2, 1), ReservoirIdentity(4, 2), 2, 4)
}

> unequal_contact_fixture() -> ContactFixture {
    ContactFixture("unequal", ReservoirIdentity(2, 1), ReservoirIdentity(2, 2), 2, 4)
}

> contact_generator(fiber_a: ContactFiber, fiber_b: ContactFiber) -> ContactGenerator {
    ContactGenerator(fiber_b.multiplicity, fiber_a.multiplicity, 0 - fiber_b.multiplicity, 0 - fiber_a.multiplicity)
}

> equal_contact_prediction() -> ContactPrediction {
    ContactPrediction(0, 1, 0, 1)
}

> unequal_contact_prediction() -> ContactPrediction {
    ContactPrediction(2, 1, 4, 1)
}

-- END POST_CONSTRUCTION_OBSERVER

-- FORBIDDEN-INPUT POISON IS AN INERT ENVELOPE, NEVER A BUILDER ARGUMENT.

# ForbiddenSentinel(name: String, value: String)
# PoisonEnvelope(state: CompleteState, sentinels: List(ForbiddenSentinel))

> project_poisoned_state(envelope: PoisonEnvelope) -> BuilderView {
    builder_view(envelope.state)
}

-- FRAMEWORK FIELDS DELIBERATELY OUTSIDE THIS APPARATUS.

# UninstantiatedFrameworkFields(path_entropy: String, accounting_price: String, tau_receipt: String, xi_drive: String)

> uninstantiated_framework_fields() -> UninstantiatedFrameworkFields {
    UninstantiatedFrameworkFields("NOT_INSTANTIATED", "NOT_INSTANTIATED", "NOT_INSTANTIATED", "NOT_INSTANTIATED")
}

-- FROZEN OBSERVATION AND REPORT ORDER. These are requested evaluations, not
-- asserted results. No held-out channel or control is exposed before the
-- completed state classification is frozen.

# ForwardProtocolEvidence(source_complete_state: CompleteState, successor_complete_state: CompleteState, receipt: ActionReceipt)
# InverseProtocolEvidence(source_complete_state: CompleteState, successor_complete_state: CompleteState, receipt: ActionReceipt)
# ProtocolTranscript(scope: String, initial_complete_state: CompleteState, terminal_complete_state: CompleteState, forward: List(ForwardProtocolEvidence), inverse: List(InverseProtocolEvidence), round_trip_exact: Bool)
# EvidenceJournal(controls: List(String), specimens: List(String), information: List(InformationReport), protocols: List(ProtocolTranscript), observations: List(String), thermal_observations: List(String), contact_observations: List(String))
# EvaluationResult = CompletedEvidence(evidence: EvidenceJournal) | LateErrorWithPreservedEvidence(detail: String, evidence: EvidenceJournal)

> preserve_late_error(detail: String, evidence: EvidenceJournal) -> EvaluationResult {
    LateErrorWithPreservedEvidence(detail, evidence)
}

# ObservationStage = RecordInitialState | ClassifyInitialState | ExecuteOrSolveConstruction | EnumerateActualShells | FreezeStateClassification | ExposeHeldOutChannels | ClassifyLabelledTraffic | CompareFrozenTemperatures | ApplyControls | PublishAllClassifications
# ObservationPlan(stages: List(ObservationStage))

> observation_plan() -> ObservationPlan {
    ObservationPlan([
        RecordInitialState,
        ClassifyInitialState,
        ExecuteOrSolveConstruction,
        EnumerateActualShells,
        FreezeStateClassification,
        ExposeHeldOutChannels,
        ClassifyLabelledTraffic,
        CompareFrozenTemperatures,
        ApplyControls,
        PublishAllClassifications
    ])
}

# ClaimLabel = StaticStructuralTheorem | OperationalThermodynamicGraph | EndogenousNonadaptiveConstructor | AdaptiveThermodynamicConstruction | EndogenousStateDependentTemperature | EndogenouslyThermodynamicAdaptiveXypher | NotAdmissible | NoResult
# ClaimLabelText(value: String)
# PrimaryContaminationEvidence(target_payload_admitted_to_policy: Bool, traffic_payload_admitted_to_policy: Bool, poison_changes_primary_trace: Bool)
# StateDependentMatchingEvidence(positive_slopes: Bool, independent_probe_operation_matches_state_slopes: Bool, independent_contact_operation_matches_state_slopes: Bool, matching_operational_controls_pass: Bool)

> demonstrated_primary_contamination(evidence: PrimaryContaminationEvidence) -> Bool {
    evidence.target_payload_admitted_to_policy || evidence.traffic_payload_admitted_to_policy || evidence.poison_changes_primary_trace
}

> may_emit_not_admissible(evidence: PrimaryContaminationEvidence) -> Bool {
    demonstrated_primary_contamination(evidence)
}

> state_dependent_label_is_admissible(evidence: StateDependentMatchingEvidence) -> Bool {
    evidence.positive_slopes && evidence.independent_probe_operation_matches_state_slopes && evidence.independent_contact_operation_matches_state_slopes && evidence.matching_operational_controls_pass
}

> claim_label_text(label: ClaimLabel) -> ClaimLabelText {
    match label {
        | StaticStructuralTheorem -> ClaimLabelText("STATIC STRUCTURAL THEOREM")
        | OperationalThermodynamicGraph -> ClaimLabelText("OPERATIONAL THERMODYNAMIC GRAPH")
        | EndogenousNonadaptiveConstructor -> ClaimLabelText("ENDOGENOUS NONADAPTIVE CONSTRUCTOR")
        | AdaptiveThermodynamicConstruction -> ClaimLabelText("ADAPTIVE THERMODYNAMIC CONSTRUCTION")
        | EndogenousStateDependentTemperature -> ClaimLabelText("ENDOGENOUS STATE-DEPENDENT TEMPERATURE")
        | EndogenouslyThermodynamicAdaptiveXypher -> ClaimLabelText("ENDOGENOUSLY THERMODYNAMIC ADAPTIVE XYPHER")
        | NotAdmissible -> ClaimLabelText("NOT ADMISSIBLE")
        | NoResult -> ClaimLabelText("NO_RESULT")
    }
}

# GateId = E01 | E02 | E03 | E04 | E05 | E06 | E07 | E08 | E09 | E10 | E11 | E12 | E13 | E14 | E15
# GatePlan(first: GateId, second: GateId, third: GateId, fourth: GateId, fifth: GateId, sixth: GateId, seventh: GateId, eighth: GateId, ninth: GateId, tenth: GateId, eleventh: GateId, twelfth: GateId, thirteenth: GateId, fourteenth: GateId, fifteenth: GateId)

> gate_plan() -> GatePlan {
    GatePlan(E01, E02, E03, E04, E05, E06, E07, E08, E09, E10, E11, E12, E13, E14, E15)
}

